[Unit]
Description=my-claw - personal AI agent
After=my-claw-xvfb.service my-claw-chromium.service my-claw-browser-sidecar.service
# Wants (not Requires): browsing is optional. A failing Xvfb/Chromium must not take the whole
# assistant down with it.
Wants=my-claw-xvfb.service my-claw-chromium.service my-claw-browser-sidecar.service

[Service]
Type=simple
WorkingDirectory={{HOME}}
# No EnvironmentFile: the server loads {{HOME}}/.my-claw/.env itself at boot and hot-reloads it.
# runtime/venv: edge-tts (cloud text-to-speech), installed there by install.sh.
Environment="PATH={{HOME}}/.my-claw/runtime/venv/bin:{{HOME}}/.local/bin:{{HOME}}/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin"
# A bare-metal install: this server starts and stops the on-demand units (my-claw-whisper) from its
# config, and its self-hosted engines are on this machine. A dev server on the same box is not one
# and touches no unit. docs/services.md, docs/on-demand-services.md
Environment="MY_CLAW_INSTALL=native"
ExecStart={{BUN}} run {{APP_DIR}}/src/index.ts
Restart=always
RestartSec=5
# The agent spawns arbitrary children via its bash tool (ffmpeg, demucs, ML jobs...). When the
# kernel OOM-kills such a child, the agent must survive to report the failure. The default
# policy would tear the whole service down and lose any in-flight response.
OOMPolicy=continue
StandardOutput=append:/var/log/my-claw/my-claw.log
StandardError=append:/var/log/my-claw/my-claw.log

[Install]
WantedBy=default.target

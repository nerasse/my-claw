# my-claw secrets — keep this file safe (chmod 600)
# Copy this to /etc/my-claw/.env and fill in your values

MY_CLAW_TELEGRAM_TOKEN=your_telegram_bot_token_here
MY_CLAW_MATRIX_ACCESS_TOKEN=your_matrix_token_here
MY_CLAW_MATRIX_PASSWORD=your_matrix_password_here
FIREWORKS_API_KEY=your_fireworks_key_here
FORGEJO_URL=https://git.kssimi.fr
FORGEJO_TOKEN=your_forgejo_token_here
NEXTCLOUD_URL=https://cloud.kssimi.fr
NEXTCLOUD_USER=your_nextcloud_user
NEXTCLOUD_TOKEN=your_nextcloud_token
GROQ_API_KEY=your_groq_key_here
LITELLM_API_KEY=your_litellm_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

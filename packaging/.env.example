# my-claw secrets, keep this file safe (chmod 600). It lives at ~/.my-claw/.env, owned by the
# service user: the server loads it at boot and picks up edits live, the updater reads the
# registry token out of it. Every value here is optional except the API key of the provider you
# actually use: config.json names an apiKeyEnv per provider, the key in this file must match it.
# Lines stay commented until they hold a real value: a key that is set but fake reads as present
# (the voice goes to the cloud with it, a provider answers 401).

# --- LLM providers (config.json llm.providers.*.apiKeyEnv) ---
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# LITELLM_API_KEY=
# COMMANDCODE_KEY=
# OPENCODE_GO_KEY=

# --- Updates / auto-update (required for `myclaw update` and the timer) ---
# Get a token with write:repository scope at <forgejo-url>/user/settings/applications
FORGEJO_URL=https://git.kssimi.fr
# FORGEJO_TOKEN=

# --- Subscriptions (backend types in config.json llm.providers.*.type) ---
# CLAUDE_CODE_OAUTH_TOKEN enables the "anthropic" backend (Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=

# --- Voice ---
# Cloud STT (voice.stt.mode = "cloud"/"auto" with GROQ_API_KEY): see src/voice/stt.ts
# GROQ_API_KEY=...
# Local STT endpoint (faster-whisper-server). Only needed to override the default,
# which matches the my-claw-whisper systemd unit (http://127.0.0.1:8000).
# FASTER_WHISPER_ENDPOINT=http://127.0.0.1:8000

# --- Optional features ---
# Location sharing (chat location resolver)
GEOAPIFY_API_KEY=
# Web search (config.json webSearch.baseUrl may need a token for the SearXNG instance)
# MY_CLAW_WEB_SEARCH_TOKEN=

# --- Memory embeddings (config.json memory.embedding.backend = "http") ---
# EMBEDDING_API_KEY=...

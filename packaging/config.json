{
  "whitelist": [],
  "blacklist": [],
  "channels": {
    "my-claw-app": {
      "enabled": true,
      "port": 8080,
      "approvals": false,
      "pairing": {
        "enabled": true
      },
      "streaming": {
        "enabled": true,
        "minChars": 30
      },
      "web": {
        "enabled": true
      },
      "devices": {}
    }
  },
  "llm": {
    "defaultProvider": "fireworks",
    "defaultModel": "accounts/fireworks/models/kimi-k2p6-turbo",
    "vision": true,
    "providers": {
      "fireworks": {
        "type": "openai",
        "baseUrl": "https://api.fireworks.ai/inference/v1",
        "apiKeyEnv": "FIREWORKS_API_KEY",
        "discover": true
      }
    },
    "models": [
      {
        "id": "accounts/fireworks/models/kimi-k2p6-turbo",
        "label": "Kimi K2.6 Turbo",
        "provider": "fireworks"
      }
    ],
    "limit": {
      "context": 128000,
      "output": 8192
    }
  },
  "agents": {
    "orchestrator": { "maxIterations": 90 },
    "general": { "maxIterations": 50 },
    "research": { "maxIterations": 50 }
  },
  "voice": {
    "mode": "auto",
    "stt": {
      "mode": "cloud",
      "echoTranscript": true,
      "language": "fr"
    },
    "tts": {
      "mode": "cloud",
      "voice": "fr-FR-RemyMultilingualNeural"
    }
  },
  "webSearch": {
    "baseUrl": "",
    "language": "fr"
  },
  "browser": {
    "enabled": true,
    "sidecarUrl": "http://127.0.0.1:9223",
    "novncUrl": "http://localhost:6080",
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "maxSteps": 60
  },
  "cron": {
    "enabled": true,
    "tickIntervalMs": 60000,
    "maxIterations": 90,
    "timeoutMs": 1800000
  },
  "injection": {
    "enabled": true,
    "budgetBonus": 8
  },
  "memory": {
    "enabled": true,
    "consolidation": {
      "enabled": true,
      "every": 20
    }
  },
  "context": {
    "cap": 512000,
    "autoCompact": {
      "enabled": true,
      "thresholdRatio": 0.8
    }
  }
}

[Unit]
Description=Faster Whisper STT server for my-claw
After=network.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
# Kill stale Whisper server from same user before starting
ExecStartPre=-/bin/sh -c 'for pid in $(pgrep -u {{USER}} -f "whisper-server.py" 2>/dev/null || true); do kill -9 "$pid" 2>/dev/null; done'
# The sidecar ships with the release. It used to call `faster-whisper-server`, a binary that is on
# no index and was never installed, then fall back to a `faster_whisper_server` module that does
# not exist: the unit failed every five seconds forever and local STT never worked once.
ExecStart={{PYTHON}} {{APP_DIR}}/packaging/whisper-server.py --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

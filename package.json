{
  "name": "my-claw",
  "version": "0.7.205",
  "description": "Self-hosted AI agent orchestrator: one agent, real tools, your own machine",
  "module": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build:tar": "bash packaging/build-tar.sh",
    "build": "bun run build:tar",
    "release": "make release",
    "clean": "rm -rf dist/",
    "postinstall": "bun scripts/apply-dependency-patches.cjs",
    "check:dependency-patches": "bun scripts/apply-dependency-patches.cjs --check && bun test ./scripts/tests/test_dependency_security.cjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/qrcode": "^1.5.6",
    "cbor": "10.0.12",
    "cron-parser": "^5.7.0",
    "markdown-it": "^15.0.2",
    "node-app-attest": "1.0.1",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "qs": "^6.16.0",
    "@hono/node-server": "^1.19.17",
    "ip-address": "^10.7.3",
    "adm-zip": "^0.6.1",
    "protobufjs": "^7.6.6",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.7",
    "sharp": "^0.35.5",
    "proxy-addr": "^2.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerasse/my-claw.git"
  },
  "author": "Yassir EL KSSIMI",
  "keywords": [
    "ai",
    "agent",
    "orchestrator",
    "llm",
    "self-hosted",
    "bun",
    "typescript"
  ],
  "homepage": "https://github.com/nerasse/my-claw#readme"
}

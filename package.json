{
  "name": "my-claw",
  "version": "0.7.43",
  "description": "Personal AI agent orchestrator built on top of pi-mono",
  "module": "src/index.ts",
  "type": "module",
  "license": "PolyForm-Small-Business-1.0.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build:tar": "bash packaging/build-tar.sh",
    "build": "bun run build:tar",
    "release": "make release",
    "clean": "rm -rf dist/"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/qrcode": "^1.5.6",
    "cron-parser": "^5.7.0",
    "markdown-it": "^15.0.0",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "qs": "^6.16.0",
    "@hono/node-server": "^1.19.17",
    "ip-address": "^10.7.0",
    "adm-zip": "^0.6.0",
    "protobufjs": "^7.6.6",
    "fast-uri": "^3.1.7",
    "hono": "^4.13.7",
    "sharp": "^0.35.0"
  }

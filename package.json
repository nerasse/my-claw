{
  "name": "my-claw",
  "version": "0.1.88",
  "description": "Personal AI agent orchestrator built on top of pi-mono",
  "module": "src/index.ts",
  "type": "module",
  "license": "PolyForm-Small-Business-1.0.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build:tar": "bash packaging/build-tar.sh",
    "build": "bun run build:tar",
    "release": "make release",
    "clean": "rm -rf dist/"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.206",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@huggingface/transformers": "^4.2.0",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.2.0",
    "cron-parser": "^5.5.0",
    "fake-indexeddb": "^5.0.2",
    "grammy": "^1.42.0",
    "markdown-it": "^14.1.1",
    "matrix-js-sdk": "^41.4.0",
    "playwright-core": "^1.59.1",
    "zod": "^4.4.3"
  }
}
